{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "JJ_AGENT": "1"
  },
  "permissions": {
    "allow": [
      "Bash(jj *)",
      "mcp__plugin_jj-agents_jj__*"
    ],
    "ask": [
      "Bash(jj undo *)",
      "Bash(jj redo *)",
      "Bash(jj abandon *)",
      "Bash(jj op restore *)",
      "Bash(jj op revert *)",
      "Bash(jj op abandon *)",
      "Bash(jj git push *)"
    ],
    "deny": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git stash *)",
      "Bash(git cherry-pick *)",
      "Bash(git add *)",
      "Bash(git worktree add *)"
    ]
  }
}
